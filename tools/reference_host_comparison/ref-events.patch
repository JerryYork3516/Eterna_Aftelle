+import Darwin
+import Foundation
+import VPReferenceCore
+
+enum VPCComparisonError: Error {
+    case invalidPipe, invalidClock, duplicateEvent, writeFailed
+}
+
+final class VPCComparisonEvents {
+    private let descriptor: Int32
+    private let runID: UUID
+    private var origin: VPBClock?
+    private var terminated = false
+
+    static func fromEnvironment(runID: String) throws -> VPCComparisonEvents? {
+        guard let value = ProcessInfo.processInfo.environment["AFTELLE_VPC_COMPARISON_FD"] else { return nil }
+        guard let descriptor = Int32(value), let identity = UUID(uuidString: runID) else {
+            throw VPCComparisonError.invalidPipe
+        }
+        return try VPCComparisonEvents(descriptor: descriptor, runID: identity)
+    }
+
+    init(descriptor: Int32, runID: UUID) throws {
+        var info = stat()
+        let flags = fcntl(descriptor, F_GETFL)
+        guard descriptor > 2, flags >= 0, flags & O_NONBLOCK != 0,
+              flags & O_ACCMODE != O_RDONLY, fstat(descriptor, &info) == 0,
+              info.st_mode & S_IFMT == S_IFIFO
+        else { throw VPCComparisonError.invalidPipe }
+        let owned = fcntl(descriptor, F_DUPFD_CLOEXEC, 3)
+        guard owned >= 0 else { throw VPCComparisonError.invalidPipe }
+        guard fcntl(owned, F_SETNOSIGPIPE, 1) == 0 else {
+            close(owned)
+            throw VPCComparisonError.invalidPipe
+        }
+        self.descriptor = owned
+        self.runID = runID
+    }
+
+    deinit { close(descriptor) }
+
+    static func nanoseconds(_ ticks: UInt64, _ numerator: UInt32, _ denominator: UInt32) throws -> UInt64 {
+        guard numerator > 0, denominator > 0 else { throw VPCComparisonError.invalidClock }
+        let product = ticks.multipliedFullWidth(by: UInt64(numerator))
+        guard product.high < UInt64(denominator) else { throw VPCComparisonError.invalidClock }
+        return UInt64(denominator).dividingFullWidth(product).quotient
+    }
+
+    static func midpoint(_ clock: VPBClock) throws -> UInt64 {
+        guard clock.valid else { throw VPCComparisonError.invalidClock }
+        let before = try nanoseconds(clock.absoluteBefore, clock.numerator, clock.denominator)
+        let after = try nanoseconds(clock.absoluteAfter, clock.numerator, clock.denominator)
+        guard after - before <= 1_000_000, after <= UInt64.max - 9_000_000_000 else {
+            throw VPCComparisonError.invalidClock
+        }
+        return before + (after - before) / 2
+    }
+
+    static func schedule(runID: UUID, clock: VPBClock) throws -> [String: Any] {
+        let start = try midpoint(clock)
+        var message: [String: Any] = ["schema_version": 1, "source": "ADAPTED_REF", "event": "schedule"]
+        message["run_id"] = runID.uuidString
+        message["clock"] = "mach_absolute_nanoseconds"
+        message["observation_start_ns"] = start
+        message["near_start_ns"] = start + 4_000_000_000
+        message["near_stop_ns"] = start + 9_000_000_000
+        message["anchor"] = ["absolute_before": clock.absoluteBefore, "continuous": clock.continuous,
+                             "absolute_after": clock.absoluteAfter, "numer": clock.numerator,
+                             "denom": clock.denominator]
+        return message
+    }
+
+    func check(clock: VPBClock) throws {
+        var readiness = pollfd(fd: descriptor, events: Int16(POLLOUT), revents: 0)
+        guard poll(&readiness, 1, 0) == 1, readiness.revents == Int16(POLLOUT) else {
+            throw VPCComparisonError.invalidPipe
+        }
+        let current = try Self.midpoint(clock)
+        guard let origin else { return }
+        guard clock.numerator == origin.numerator, clock.denominator == origin.denominator,
+              clock.continuous >= origin.continuous, clock.absoluteBefore >= origin.absoluteAfter
+        else { throw VPCComparisonError.invalidClock }
+        let elapsed = try Self.nanoseconds(clock.continuous - origin.continuous, clock.numerator, clock.denominator)
+        let first = try Self.midpoint(origin)
+        guard current >= first else { throw VPCComparisonError.invalidClock }
+        let absoluteElapsed = current - first
+        let difference = max(elapsed, absoluteElapsed) - min(elapsed, absoluteElapsed)
+        guard difference <= 1_000_000 else { throw VPCComparisonError.invalidClock }
+    }
+
+    func event(_ clock: VPBClock) throws {
+        guard !terminated else { throw VPCComparisonError.duplicateEvent }
+        try check(clock: clock)
+        guard clock.id == "observationStart" else { return }
+        guard origin == nil else { throw VPCComparisonError.duplicateEvent }
+        try send(Self.schedule(runID: runID, clock: clock))
+        origin = clock
+    }
+
+    func terminal(cancelled: Bool, clock: VPBClock) throws {
+        guard !terminated else { return }
+        terminated = true
+        var message: [String: Any] = ["schema_version": 1, "source": "ADAPTED_REF"]
+        message["event"] = cancelled ? "cancel" : "stop"
+        message["run_id"] = runID.uuidString
+        message["clock"] = "mach_absolute_nanoseconds"
+        message["event_time_ns"] = try Self.midpoint(clock)
+        try send(message)
+    }
+
+    private func send(_ message: [String: Any]) throws {
+        var data = try JSONSerialization.data(withJSONObject: message, options: [.sortedKeys])
+        data.append(10)
+        // <= PIPE_BUF: one atomic, nonblocking write on the control path, never a Tap.
+        guard data.count <= 512 else { throw VPCComparisonError.writeFailed }
+        let count = data.withUnsafeBytes { write(descriptor, $0.baseAddress, $0.count) }
+        guard count == data.count else { throw VPCComparisonError.writeFailed }
+    }
+}

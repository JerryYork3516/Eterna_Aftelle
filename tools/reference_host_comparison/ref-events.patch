+import Darwin
+import Foundation
+@testable import VPReferenceAudio
+import VPReferenceCore
+import XCTest
+
+final class VPCComparisonEventsTests: XCTestCase {
+    private let identity = UUID(uuid: (17, 17, 17, 17, 17, 17, 65, 17, 129, 17, 17, 17, 17, 17, 17, 17))
+
+    private func point(_ id: String = "observationStart", at tick: UInt64 = 1_000_000_000) -> VPBClock {
+        VPBClock(id: id, absoluteBefore: tick, continuous: tick + 900_000,
+                 absoluteAfter: tick + 2, numerator: 125, denominator: 3)
+    }
+
+    private func withPipe(_ body: (VPCComparisonEvents, Int32, Int32) throws -> Void) throws {
+        var descriptors: [Int32] = [-1, -1]
+        XCTAssertEqual(pipe(&descriptors), 0)
+        defer { close(descriptors[0]); close(descriptors[1]) }
+        for descriptor in descriptors {
+            XCTAssertEqual(fcntl(descriptor, F_SETFL, O_NONBLOCK), 0)
+        }
+        let events = try VPCComparisonEvents(descriptor: descriptors[1], runID: identity)
+        try body(events, descriptors[0], descriptors[1])
+    }
+
+    private func messages(_ descriptor: Int32) throws -> [[String: Any]] {
+        var bytes = [UInt8](repeating: 0, count: 4096)
+        let count = read(descriptor, &bytes, bytes.count)
+        guard count >= 0 else { throw VPCComparisonError.invalidPipe }
+        return try Data(bytes.prefix(count)).split(separator: 10).map {
+            try XCTUnwrap(JSONSerialization.jsonObject(with: Data($0)) as? [String: Any])
+        }
+    }
+
+    func testExactTimebaseConversionAndBoundedSchedule() throws {
+        XCTAssertEqual(try VPCComparisonEvents.nanoseconds(3, 125, 3), 125)
+        XCTAssertThrowsError(try VPCComparisonEvents.nanoseconds(UInt64.max, 125, 1))
+        XCTAssertThrowsError(try VPCComparisonEvents.nanoseconds(1, 1, 0))
+        let message = try VPCComparisonEvents.schedule(runID: identity, clock: point())
+        XCTAssertEqual(message["observation_start_ns"] as? UInt64, 41_666_666_708)
+        XCTAssertEqual(message["near_start_ns"] as? UInt64, 45_666_666_708)
+        XCTAssertEqual(message["near_stop_ns"] as? UInt64, 50_666_666_708)
+        XCTAssertLessThanOrEqual(try JSONSerialization.data(withJSONObject: message).count + 1, 512)
+    }
+
+    func testScheduleTerminalOnceAndDuplicateRejected() throws {
+        try withPipe { events, reader, _ in
+            try events.event(point())
+            XCTAssertThrowsError(try events.event(point(at: 1_000_000_010)))
+            try events.terminal(cancelled: false, clock: point("stop", at: 2_000_000_000))
+            try events.terminal(cancelled: true, clock: point("cancel", at: 2_000_000_000))
+            XCTAssertEqual(try messages(reader).compactMap { $0["event"] as? String }, ["schedule", "stop"])
+            XCTAssertThrowsError(try events.event(point(at: 1_000_000_020)))
+        }
+    }
+
+    func testCancelBeforeScheduleHasNoPlayPlan() throws {
+        try withPipe { events, reader, _ in
+            try events.terminal(cancelled: true, clock: point("cancel", at: 2_000_000_000))
+            XCTAssertEqual(try messages(reader).compactMap { $0["event"] as? String }, ["cancel"])
+        }
+    }
+
+    func testClosedReaderAndFullPipeRejectWithoutWaiting() throws {
+        var descriptors: [Int32] = [-1, -1]
+        XCTAssertEqual(pipe(&descriptors), 0)
+        defer { close(descriptors[1]) }
+        XCTAssertEqual(fcntl(descriptors[1], F_SETFL, O_NONBLOCK), 0)
+        let closed = try VPCComparisonEvents(descriptor: descriptors[1], runID: identity)
+        XCTAssertEqual(close(descriptors[0]), 0)
+        XCTAssertThrowsError(try closed.event(point()))
+        XCTAssertThrowsError(try closed.terminal(cancelled: true, clock: point("cancel", at: 2_000_000_000)))
+        try withPipe { events, _, writer in
+            let data = [UInt8](repeating: 1, count: 512)
+            var writes = 0
+            while write(writer, data, data.count) == data.count {
+                writes += 1
+                XCTAssertLessThan(writes, 1024)
+                if writes >= 1024 {
+                    throw VPCComparisonError.invalidPipe
+                }
+            }
+            XCTAssertEqual(errno, EAGAIN)
+            XCTAssertThrowsError(try events.event(point()))
+        }
+    }
+
+    func testInvalidPipeDescriptorRejected() throws {
+        for descriptor: Int32 in [-1, 0, 1, 2] {
+            XCTAssertThrowsError(try VPCComparisonEvents(descriptor: descriptor, runID: identity))
+        }
+        var descriptors: [Int32] = [-1, -1]
+        XCTAssertEqual(pipe(&descriptors), 0)
+        defer { close(descriptors[0]); close(descriptors[1]) }
+        XCTAssertThrowsError(try VPCComparisonEvents(descriptor: descriptors[1], runID: identity))
+    }
+
+    func testClockSleepBackwardAndWideBracketRejected() throws {
+        try withPipe { events, _, _ in
+            try events.event(point())
+            try events.check(clock: point("check", at: 1_000_010_000))
+            XCTAssertThrowsError(try events.check(clock: point("check", at: 999_999_000)))
+            let slept = VPBClock(
+                id: "check", absoluteBefore: 1_000_020_000, continuous: 1_002_920_000,
+                absoluteAfter: 1_000_020_002, numerator: 125, denominator: 3
+            )
+            XCTAssertThrowsError(try events.check(clock: slept))
+        }
+        let wide = VPBClock(id: "observationStart", absoluteBefore: 1, continuous: 100,
+                            absoluteAfter: 2_000_001, numerator: 1, denominator: 1)
+        XCTAssertThrowsError(try VPCComparisonEvents.midpoint(wide))
+    }
+
+    func testOriginalWindowGeneratesPlanAndKeepsCueOffsets() throws {
+        try withPipe { events, reader, _ in
+            var elapsed = 0.0
+            var cues: [VPCCue] = []
+            var playTimes: [Double] = []
+            func clock(_ id: String) -> VPBClock {
+                let tick = 1_000_000_000 + UInt64((elapsed * 1_000_000_000).rounded())
+                return VPBClock(id: id, absoluteBefore: tick, continuous: tick,
+                                absoluteAfter: tick, numerator: 1, denominator: 1)
+            }
+            try VPCWindow.run(clock: (1_000_000_000, { elapsed }), observe: { _ in
+                try events.check(clock: clock("observe"))
+                return (true, true)
+            }, event: { id in
+                let value = clock(id)
+                try events.event(value)
+                return value
+            }, perform: { action in
+                switch action {
+                case .play: playTimes.append(elapsed); return nil
+                case let .cue(cue):
+                    cues.append(cue)
+                    return VPBDisplayReceipt(cueID: cue.rawValue, requested: clock(cue.rawValue),
+                                             displayed: clock(cue.rawValue), visible: true)
+                }
+            }, wait: { elapsed += $0 })
+            try events.terminal(cancelled: false, clock: clock("stop"))
+            XCTAssertEqual(cues, VPCCue.allCases)
+            XCTAssertEqual(playTimes.count, 1)
+            XCTAssertEqual(try XCTUnwrap(playTimes.first), 2, accuracy: 0.001)
+            XCTAssertEqual(elapsed, 13.5, accuracy: 0.001)
+            let recorded = try messages(reader)
+            XCTAssertEqual(recorded.count, 2)
+            XCTAssertEqual(recorded[0]["run_id"] as? String, identity.uuidString)
+        }
+    }
+}
